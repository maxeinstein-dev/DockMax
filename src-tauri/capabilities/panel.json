{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel",
  "description": "Capability for the panel window",
  "windows": ["panel"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-hide-panel",
    "allow-panel-ready",
    "allow-get-settings",
    "allow-update-settings",
    "allow-list-widgets",
    "allow-add-widget",
    "allow-remove-widget",
    "allow-move-widget",
    "allow-update-widget",
    "allow-get-note",
    "allow-save-note",
    "allow-dismiss-storage-notice",
    "allow-list-tray",
    "allow-tray-click",
    "log:allow-log"
  ]
}
