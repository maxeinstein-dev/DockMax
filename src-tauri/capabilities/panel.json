{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel",
  "description": "Capability for the panel window",
  "windows": ["panel"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-hide-panel",
    "allow-panel-ready",
    "allow-panel-mounted",
    "allow-get-settings",
    "allow-update-settings",
    "allow-list-widgets",
    "allow-add-widget",
    "allow-remove-widget",
    "allow-move-widget",
    "allow-update-widget",
    "allow-get-note",
    "allow-save-note",
    "allow-dismiss-storage-notice",
    "allow-list-tray",
    "allow-tray-click",
    "allow-read-system-activity",
    "allow-calendar-events",
    "allow-open-calendar-link",
    "allow-complete-calendar-task",
    "allow-cycle-status",
    "allow-tray-to-dock",
    "allow-list-apps",
    "allow-list-catalog",
    "allow-app-icon",
    "allow-pin-app",
    "allow-unpin-app",
    "allow-move-app",
    "allow-launch-app",
    "allow-app-menu",
    "allow-run-app-entry",
    "allow-reveal-app",
    "allow-list-open-apps",
    "allow-launch-open",
    "allow-close-app",
    "allow-close-open",
    "allow-pin-open",
    "allow-list-workspaces",
    "allow-move-app-windows",
    "allow-move-open-windows",
    "allow-list-icon-packs",
    "allow-reload-icon-packs",
    "allow-open-icon-packs-folder",
    "log:allow-log"
  ]
}
