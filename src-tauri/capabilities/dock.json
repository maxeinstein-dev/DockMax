{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dock",
  "description": "Capability for the dock window",
  "windows": ["dock"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-toggle-panel",
    "allow-set-dock-layout",
    "allow-get-settings",
    "log:allow-log"
  ]
}
