{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dock",
  "description": "Capability for the dock window",
  "windows": ["dock"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-toggle-panel",
    "allow-set-dock-layout",
    "allow-get-settings",
    "allow-list-widgets",
    "allow-open-flyout",
    "allow-list-apps",
    "allow-app-icon",
    "allow-launch-app",
    "allow-list-open-apps",
    "allow-activate-app",
    "allow-activate-open",
    "allow-launch-open",
    "allow-place-app",
    "log:allow-log"
  ]
}
