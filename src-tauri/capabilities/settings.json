{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Capability for the Configurações app window (spec 0011 H1)",
  "windows": ["settings"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "allow-get-settings",
    "allow-update-settings",
    "allow-list-widgets",
    "allow-add-widget",
    "allow-remove-widget",
    "allow-move-widget",
    "allow-dismiss-storage-notice",
    "allow-list-apps",
    "allow-list-catalog",
    "allow-app-icon",
    "allow-pin-app",
    "allow-unpin-app",
    "allow-move-app",
    "allow-list-icon-packs",
    "allow-reload-icon-packs",
    "allow-open-icon-packs-folder",
    "allow-list-tray",
    "allow-launcher-status",
    "allow-clear-launcher-history",
    "allow-set-launcher-hotkey",
    "allow-capture-launcher-hotkey",
    "allow-list-workspaces",
    "allow-create-workspace",
    "allow-rename-workspace",
    "allow-recolor-workspace",
    "allow-move-workspace",
    "allow-delete-workspace",
    "allow-share-widget",
    "log:allow-log"
  ]
}
